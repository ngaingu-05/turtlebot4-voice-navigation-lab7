#!/usr/bin/env python3
"""Generate original map copies, region labels, preview and safe semantic goals."""
import argparse
import yaml
from semantic_map import GridMap, save_segmentation


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--map', required=True, dest='map_file')
    parser.add_argument('--seeds', required=True)
    parser.add_argument('--output', required=True)
    parser.add_argument('--clearance', type=float, default=.4)
    args = parser.parse_args()
    with open(args.seeds, encoding='utf-8') as stream:
        definitions = yaml.safe_load(stream)['regions']
    result = save_segmentation(GridMap(args.map_file), definitions, args.output, args.clearance)
    for region in result['regions']:
        print(f'{region["id"]}: {region["name"]}: {region["goal"]}; clearance={region["clearance_m"]:.2f} m')
    print(f'Unassigned free cells: {result["unassigned_free_cells"]}')


if __name__ == '__main__':
    main()
