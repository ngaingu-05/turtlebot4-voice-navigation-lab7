#!/usr/bin/env python3
"""Push-to-talk Vietnamese Whisper recognition, or transcribe one audio file."""
import argparse
from pathlib import Path
import time
import wave

import numpy as np
import rclpy
from rclpy.node import Node
from std_msgs.msg import String


def transcribe(model, audio):
    segments, _ = model.transcribe(audio, language='vi', beam_size=5, vad_filter=True,
                                  condition_on_previous_text=False)
    return ' '.join(segment.text.strip() for segment in segments
                    if segment.no_speech_prob < .6 and segment.avg_logprob >= -1.0).strip()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--model', default='small', help='Multilingual faster-whisper model ID or local directory')
    parser.add_argument('--audio', help='Transcribe an audio file once instead of microphone')
    parser.add_argument('--seconds', type=float, default=6)
    parser.add_argument('--device', type=int, help='sounddevice input device index')
    parser.add_argument('--list-devices', action='store_true')
    parser.add_argument('--save-dir', help='Keep microphone WAV recordings for demo evidence')
    parser.add_argument('--dry-run', action='store_true', help='Transcribe without publishing navigation commands')
    args, ros_args = parser.parse_known_args()
    if not np.isfinite(args.seconds) or not .5 <= args.seconds <= 30:
        parser.error('--seconds must be between .5 and 30')
    if args.list_devices:
        import sounddevice as sd
        print(sd.query_devices())
        return
    from faster_whisper import WhisperModel
    print(f'Loading Whisper {args.model} on CPU (int8); first use may download model.', flush=True)
    model = WhisperModel(args.model, device='cpu', compute_type='int8')
    rclpy.init(args=ros_args)
    node = Node('speech_recognition')
    publisher = node.create_publisher(String, 'voice_nav/text', 10)
    status = node.create_publisher(String, 'voice_nav/transcript', 10)
    try:
        while rclpy.ok():
            if args.audio:
                audio = str(Path(args.audio).resolve())
            else:
                input('Nhấn Enter để thu âm (Ctrl+C để thoát): ')
                import sounddevice as sd
                print(f'Đang nghe trong {args.seconds:g} giây...', flush=True)
                audio = sd.rec(int(args.seconds * 16000), samplerate=16000, channels=1,
                               dtype='float32', device=args.device)
                sd.wait()
                audio = audio[:, 0].copy()
                if args.save_dir:
                    folder = Path(args.save_dir)
                    folder.mkdir(parents=True, exist_ok=True)
                    with wave.open(str(folder / f'command_{time.time_ns()}.wav'), 'wb') as stream:
                        stream.setnchannels(1)
                        stream.setsampwidth(2)
                        stream.setframerate(16000)
                        stream.writeframes((np.clip(audio, -1, 1) * 32767).astype('<i2').tobytes())
                if np.sqrt(np.mean(audio ** 2)) < .005:
                    print('Âm thanh quá nhỏ; không gửi lệnh.', flush=True)
                    continue
            text = transcribe(model, audio)
            print(f'Nhận dạng: {text or "(không nhận được giọng nói)"}', flush=True)
            if text:
                status.publish(String(data=text))
                if not args.dry_run:
                    deadline = time.monotonic() + 5
                    while publisher.get_subscription_count() == 0 and time.monotonic() < deadline:
                        rclpy.spin_once(node, timeout_sec=.1)
                    if publisher.get_subscription_count() == 0:
                        node.get_logger().error('Không có node nhận lệnh; chưa gửi. Khởi chạy voice.launch.py rồi thử lại.')
                    else:
                        publisher.publish(String(data=text))
                        # Give DDS time to deliver the last message before one-shot exit.
                        rclpy.spin_once(node, timeout_sec=.2)
            if args.audio:
                break
    except (KeyboardInterrupt, EOFError):
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
